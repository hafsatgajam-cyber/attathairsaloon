# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Salon WhatsApp number in international format, digits only (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (optional; leave blank to take bookings without a deposit) ---
PAYSTACK_SECRET_KEY=

# --- WhatsApp Business Cloud API (optional; leave blank to skip messages) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names (language: en)
WHATSAPP_TEMPLATE_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=booking_reminder

# --- Vercel Cron (protects /api/cron/*) ---
CRON_SECRET=
